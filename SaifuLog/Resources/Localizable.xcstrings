    },
    "App Store の購入の確認が出ます" : {
      "comment" : "プレミアムのシート（⑨）。購入のボタンの VoiceOver の説明",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The App Store will ask you to confirm the purchase."
          }
        }
