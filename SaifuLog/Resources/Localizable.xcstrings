{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ オーバー" : {
      "comment" : "ホームの上の帯。今月の予算を超えた額。%@ は「¥12,000」のような金額。注意の色とアイコンを添えて出す",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ over"
          }
        }
      }
    },
    "%@の記録を削除します。この操作は取り消せません。" : {
      "comment" : "記録の削除の確認の本文。%@ は「ランチ ¥850」のような品目と金額",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be deleted. This can’t be undone."
          }
        }
      }
    },
    "1か月に使うお金の上限を決めると、ホームに今月あといくら使えるかと、1日あたりに使える額が出ます。" : {
      "comment" : "予算を決める画面の説明",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set how much you plan to spend in a month, and Home shows how much is left this month and how much you can spend per day."
          }
        }
      }
    },
    "1日あたり %@" : {
      "comment" : "ホームの上の帯。月末まで 1 日あたりに使える額（今日を含む）。%@ は「¥31,000」のような金額",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a day"
          }
        }
      }
    },
    "OK" : {
      "comment" : "アラートを閉じるボタン",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "「ランチ 850」のように、金額の数字を入れてください。" : {
      "comment" : "入力に金額が無かったときのアラートの本文。例の「ランチ 850」は訳さない（解析が日本語の入力を前提にしているため）",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include the amount as a number, like “ランチ 850”."
          }
        }
      }
    },
    "この記録を削除しますか？" : {
      "comment" : "記録の削除の確認の見出し",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete this record?"
          }
        }
      }
    },
    "その他" : {
      "comment" : "カテゴリ",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other"
          }
        }
      }
    },
    "のこり %lld 日" : {
      "comment" : "ホームの上の帯。月末までの日数（今日を含む）。%lld は日数",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld day left"
