        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Premium purchase was found for this Apple Account. Make sure you're signed in with the Apple Account you used to buy it."
          }
        }
      }
    },
    "この Apple アカウントで購入したプレミアムを読み込みます" : {
