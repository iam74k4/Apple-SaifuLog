{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ から %@ にしました。" : {
      "comment" : "チャットの文で金額を直した後の返事のカードの本文（品目の無い記録）。1 つ目の %@ は直す前の金額、2 つ目は直した後の金額",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changed from %1$@ to %2$@."
          }
        }
      }
    },
    "%@ の保護クラス" : {
      "comment" : "社内テスト用と開発用（DEBUG）のビルドだけの診断画面。保存先のファイルのデータ保護のクラスの項目名。%@ は default.store などのファイル名",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protection class of %@"
          }
        }
      }
    },
    "%@ までの金額にしてください。" : {
      "comment" : "直すシートで金額が上限を超えたとき、保存できない理由として出す。%@ は「¥999,999,999,999」（記録できる最大の額）",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter an amount up to %@."
          }
        }
      }
    },
    "%@ を%lld人で割り勘。" : {
      "comment" : "ホームの返事の行の下の文（割り勘で、立て替えた額が無いとき）。%1$@ は総額、%2$lld は人数（2 以上）",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ split %2$lld ways."
          }
        }
      }
