              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld days left"
                }
              }
            }
          }
        }
      }
    },
    "ひとことで記録" : {
      "comment" : "記録が無いときの案内の見出し",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record in one line"
          }
        }
      }
    },
    "もう一度試しましたが、記録を開けませんでした" : {
      "comment" : "記録の保存先を開けなかったときの画面で、再試行してもまた開けなかったときに VoiceOver で読み上げる内容",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tried again, but still couldn’t open your records."
