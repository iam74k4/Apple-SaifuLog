<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  プライバシーマニフェスト。App Store のプライバシー表示（データの収集なし）と PRIVACY.md に合わせる。
  トラッキングはしない。開発者が受け取るデータは無い（記録も AI の処理も端末の中で完結する）。
  UserDefaults（CA92.1: アプリ自身の設定の保存）は、初回の案内などの設定を覚えるために使う
  （予算の金額は家計の記録と同じ SwiftData の保存先に置く）。
  レシートの読み取り（カメラ・写真の選択）は、画像を端末の中で読み、保存も送信もしないので、収集するデータに当たらない。
  カメラも写真の選択（PhotosPicker）も理由の申告が要る API ではないので、ここに足すものは無い（docs/design.md §11）。
  声の入力（マイク）は、声を端末の中の SpeechAnalyzer で書き起こし、録音を残さず送信もしないので、収集するデータに当たらない。
  マイク・書き起こし・回線の種類（NWPathMonitor）も理由の申告が要る API ではないので、足すものは無い。
  データの扱いを変えるときは、PRIVACY.md とこのファイルを先に直す。
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
