{
  "sourceLanguage" : "ja",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "ホーム画面に出るアプリ名",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaifuLog"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイフログ"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "カメラの利用の許可を求める画面の説明。レシートを撮る書類カメラ（④）で使う",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaifuLog uses the camera to photograph receipts and record them. Photos are read on your iPhone and are never saved or sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシートを撮って記録するためにカメラを使います。写真は端末の中で読み取り、保存も送信もしません。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Face ID の利用の許可を求める画面の説明。設定の「Face ID でロック」で、アプリのロックを解除するときに使う",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SaifuLog uses Face ID to unlock the app. Your face data never reaches the app and is never saved or sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのロックを解除するために Face ID を使います。顔のデータはアプリに渡らず、保存も送信もしません。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
